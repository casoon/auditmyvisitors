---
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
// Animated SVG built with castwright from site/captures/help.terminal.yaml.
import helpSvg from '../../captures/help.svg?url';
import Diagram from '../components/Diagram.astro';

const usage = `auditmyvisitors auth login          # sign in with Google
auditmyvisitors properties select   # pick your website
auditmyvisitors report overview     # your first report`;
---

<Base>
  <Hero
    title="Your Analytics and Search Console, in plain answers."
    lead="auditmyvisitors puts Google Analytics 4 and Search Console side by side and turns them into reports you can act on: which pages bring visitors, which ones Google shows but people rarely click, and what changed after your last update. It runs on your own computer, with your own Google login, and only ever reads."
  >
    <Install
      commands={[
        {
          label: 'macOS · Linux',
          command:
            'curl -fsSL https://raw.githubusercontent.com/casoon/auditmyvisitors/main/install.sh | bash',
        },
      ]}
    />
    <Badges>
      <Badge>Free · MIT</Badge>
      <Badge>v0.3.1</Badge>
      <Badge>macOS · Linux · Windows</Badge>
    </Badges>
    <img
      slot="output"
      class="terminal-demo"
      src={helpSvg}
      width="561.6"
      height="422"
      alt="Terminal: auditmyvisitors --version prints 'auditmyvisitors 0.3.1'. auditmyvisitors --help then prints 'Google Analytics 4 & Search Console reporting for website owners' and the commands auth, properties, report, export, snapshot and help, with the options --verbose, --help and --version."
    />
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Site owners, SEO and marketing people',
        body: 'You look after a website and want straight answers from GA4 and Search Console, without building dashboards or learning a BI tool.',
      },
      {
        title: 'Answers instead of dashboards',
        body: 'Which pages bring visitors, which ones rank but get few clicks, which are slowly losing ground, and where the easiest gains are, ranked by expected effect.',
      },
      {
        title: 'Before and after a change',
        body: 'Did the relaunch or the new page title help? Compare the weeks before and after a date, for the whole site or for a single page.',
      },
      {
        title: 'Something to pass on',
        body: 'Save a full report as PDF for a client or a colleague, or single reports as CSV and JSON for your own spreadsheets.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '12', label: 'ready-made reports, from overview to countries' },
      { value: '3', label: 'export formats: PDF, CSV and JSON' },
      { value: '0', label: 'write access to your Google data' },
      { value: '0', label: 'servers of ours between you and Google' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        You run auditmyvisitors on your own computer and sign in with Google once. It reads your
        Analytics and Search Console data, puts both side by side for every page and shows the
        result right in the terminal, or saves it as a file.
      </p>
      <p>
        Your login and your data stay with you. auditmyvisitors only asks for read access, so it
        cannot change anything in your Google accounts. There is no account with us, no tracking
        and no server in between.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 560, height: 720 }} />
    <div class="links">
      <Button href={url('docs/guides/how-it-works/')} variant="secondary">How it works in detail</Button>
      <Button href={url('docs/guides/data-and-privacy/')} variant="secondary">Data and privacy</Button>
      <Button href="https://auditmyvisitors.casoon.de/" variant="quiet">Product website →</Button>
    </div>
  </section>

  <Quickstart
    lead="Install it, sign in, pick your website, and the first report is on screen. Or just type auditmyvisitors and it walks you through the same steps in a menu."
    steps={[
      'Install it with the line above. On Windows, download it from the GitHub releases page.',
      'Sign in with your Google account and allow read access.',
      'Pick your website and run your first report.',
    ]}
  >
    <CodeBlock code={usage} lang="sh" label="Three commands" />
  </Quickstart>
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
